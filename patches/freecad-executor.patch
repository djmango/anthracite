+        return {
+            "ok": False,
+            "revision": revision,
+            "rolledBack": rolled_back,
+            "revisionBefore": revision_before,
+            "requiresInspection": not rolled_back or bool(remapped),
+            "topologyMappingsChanged": remapped,
+            "stdout": _bounded(stdout.getvalue()),
+            "stderr": _bounded(stderr.getvalue()),
+            "error": {
