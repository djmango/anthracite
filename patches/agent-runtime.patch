+// SPDX-License-Identifier: LGPL-2.1-or-later
+//! Keep terminal SIGINT away from embedded Python; forward shutdown as SIGTERM.
+use std::ffi::OsString;
+
+#[cfg(unix)]
+pub fn run(arguments: Vec<OsString>) -> std::io::Result<i32> {
+    use std::os::unix::process::{CommandExt, ExitStatusExt};
+    use std::process::{Command, Stdio};
+    use std::sync::atomic::{AtomicBool, Ordering};
+    use std::time::{Duration, Instant};
+
+    static STOP: AtomicBool = AtomicBool::new(false);
+    extern "C" fn stop(_: libc::c_int) {
+        STOP.store(true, Ordering::Relaxed);
+    }
+    let executable = arguments.first().ok_or_else(|| {
+        std::io::Error::new(std::io::ErrorKind::InvalidInput, "--supervise requires an executable")
+    })?;
+    // Install before spawning so a shutdown request cannot race child creation.
+    // The handler only writes a lock-free flag; no allocation or I/O in signals.
+    unsafe {
+        let mut action: libc::sigaction = std::mem::zeroed();
+        action.sa_sigaction = stop as *const () as usize;
+        action.sa_flags = libc::SA_RESTART;
+        libc::sigemptyset(&mut action.sa_mask);
+        for signal in [libc::SIGINT, libc::SIGTERM, libc::SIGHUP] {
+            if libc::sigaction(signal, &action, std::ptr::null_mut()) != 0 {
+                return Err(std::io::Error::last_os_error());
+            }
+        }
+    }
+    let mut child = Command::new(executable)
+        .args(&arguments[1..])
+        .stdin(Stdio::null())
+        .process_group(0)
+        .spawn()?;
+    let group = -(child.id() as libc::pid_t);
+    let mut stopping = None;
+    loop {
+        if let Some(status) = child.try_wait()? {
+            return Ok(if stopping.is_some() { 0 } else { status.code().unwrap_or(128 + status.signal().unwrap_or(1)) });
+        }
+        if STOP.load(Ordering::Relaxed) && stopping.is_none() {
+            // This is the child's dedicated group, never the user's shell group.
+            unsafe { libc::kill(group, libc::SIGTERM); }
+            stopping = Some(Instant::now());
+        }
+        if stopping.is_some_and(|start| start.elapsed() >= Duration::from_secs(5)) {
+            unsafe { libc::kill(group, libc::SIGKILL); }
+            child.wait()?;
+            return Ok(0);
+        }
+        std::thread::sleep(Duration::from_millis(20));
+    }
+}
