+    #[test]
+    fn streaming_edits_do_not_retransmit_previous_images() {
+        let mut timeline = Timeline::default();
+        timeline.apply("content.user", &json!({"text":"Render"}));
+        timeline.apply("tool.observation", &json!({"images":["large-image-bytes"]}));
+        let edits = timeline.apply(
+            "content.delta",
+            &json!({"streamKind":"assistant_text", "text":"Done"}),
+        );
+        assert!(
+            !serde_json::to_string(&edits)
+                .unwrap()
+                .contains("large-image-bytes")
+        );
+        timeline.apply(
+            "content.delta",
+            &json!({"streamKind":"reasoning_text", "messageId":"r", "text":"One"}),
+        );
+        timeline.apply(
+            "content.delta",
+            &json!({"streamKind":"reasoning_text", "messageId":"r", "text":" two"}),
+        );
+        assert_eq!(timeline.rows.last().unwrap()["body"], "One two");
+    }
