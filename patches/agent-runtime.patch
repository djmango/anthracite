+            "type": "turn.start",
+            "payload": {"prompt": "Make a box"}
+        });
+        assert_eq!(message_type(&message), "turn.start");
+        assert_eq!(
+            payload(&message).get("prompt").and_then(Value::as_str),
+            Some("Make a box")
+        );
+    }
+}
