+// SPDX-License-Identifier: LGPL-2.1-or-later
+
+use serde_json::Value;
+use std::io::{BufRead, BufReader, Write};
+use std::net::{TcpListener, TcpStream};
+use std::process::{Child, ChildStdin, Command, Stdio};
+use std::sync::{Arc, Mutex, mpsc};
+use std::thread;
+
+pub enum IoEvent {
+    HostLine(String),
+    HostClosed,
+    ProviderLine(String),
+    ProviderLog(String),
+    ProviderError(String),
+    ProviderClosed,
+    McpMessage {
+        message: Value,
+        response: Option<mpsc::Sender<Value>>,
+    },
+}
+
+pub fn spawn_host_reader(sender: mpsc::Sender<IoEvent>) {
+    thread::spawn(move || {
+        for line in std::io::stdin().lock().lines() {
+            match line {
+                Ok(line) => {
+                    if sender.send(IoEvent::HostLine(line)).is_err() {
+                        return;
+                    }
+                }
+                Err(error) => {
+                    let _ = sender.send(IoEvent::ProviderError(error.to_string()));
+                    return;
+                }
+            }
+        }
+        let _ = sender.send(IoEvent::HostClosed);
+    });
+}
+
+fn spawn_line_reader<R: std::io::Read + Send + 'static>(
+    reader: R,
+    sender: mpsc::Sender<IoEvent>,
+    map: fn(String) -> IoEvent,
+    closed: Option<IoEvent>,
+) {
+    thread::spawn(move || {
+        for line in BufReader::new(reader).lines() {
+            match line {
+                Ok(line) => {
+                    if sender.send(map(line)).is_err() {
+                        return;
+                    }
+                }
+                Err(error) => {
+                    let _ = sender.send(IoEvent::ProviderError(error.to_string()));
+                    return;
+                }
+            }
+        }
+        if let Some(event) = closed {
+            let _ = sender.send(event);
+        }
+    });
+}
+
+pub struct LineProcess {
+    child: Child,
+    input: Arc<Mutex<ChildStdin>>,
+}
+
+impl LineProcess {
+    pub fn start(
+        binary: &str,
+        arguments: &[&str],
+        cwd: &str,
+        sender: &mpsc::Sender<IoEvent>,
+    ) -> Result<Self, String> {
+        let mut child = Command::new(binary)
+            .args(arguments)
+            .current_dir(cwd)
+            .stdin(Stdio::piped())
+            .stdout(Stdio::piped())
+            .stderr(Stdio::piped())
+            .spawn()
+            .map_err(|error| format!("Could not start provider at {binary}: {error}"))?;
+
+        let input = child
+            .stdin
+            .take()
+            .ok_or_else(|| "Provider did not expose standard input.".to_string())?;
+        let output = child
+            .stdout
+            .take()
+            .ok_or_else(|| "Provider did not expose standard output.".to_string())?;
+        let errors = child
+            .stderr
+            .take()
+            .ok_or_else(|| "Provider did not expose standard error.".to_string())?;
+
+        spawn_line_reader(
+            output,
+            sender.clone(),
+            IoEvent::ProviderLine,
+            Some(IoEvent::ProviderClosed),
+        );
+        spawn_line_reader(errors, sender.clone(), IoEvent::ProviderLog, None);
+
+        Ok(Self {
+            child,
+            input: Arc::new(Mutex::new(input)),
+        })
+    }
+
+    pub fn send(&self, value: &Value) -> Result<(), String> {
+        let mut input = self
+            .input
+            .lock()
+            .map_err(|_| "Provider input lock was poisoned.".to_string())?;
+        serde_json::to_writer(&mut *input, value).map_err(|error| error.to_string())?;
+        input.write_all(b"\n").map_err(|error| error.to_string())?;
+        input.flush().map_err(|error| error.to_string())
+    }
+}
+
+impl Drop for LineProcess {
+    fn drop(&mut self) {
+        let _ = self.child.kill();
+        let _ = self.child.wait();
+    }
+}
+
+pub struct ChildProcess {
+    child: Child,
+}
+
+impl ChildProcess {
+    pub fn start(
+        binary: &str,
+        arguments: &[&str],
+        cwd: &str,
+        environment: &[(&str, &str)],
+        sender: &mpsc::Sender<IoEvent>,
+    ) -> Result<Self, String> {
+        let mut child = Command::new(binary)
+            .args(arguments)
+            .current_dir(cwd)
+            .envs(environment.iter().copied())
+            .stdin(Stdio::null())
+            .stdout(Stdio::piped())
+            .stderr(Stdio::piped())
+            .spawn()
+            .map_err(|error| format!("Could not start provider at {binary}: {error}"))?;
+        let output = child
+            .stdout
+            .take()
+            .ok_or_else(|| "Provider did not expose standard output.".to_string())?;
+        let errors = child
+            .stderr
+            .take()
+            .ok_or_else(|| "Provider did not expose standard error.".to_string())?;
+        spawn_line_reader(
+            output,
+            sender.clone(),
+            IoEvent::ProviderLog,
+            Some(IoEvent::ProviderClosed),
+        );
+        spawn_line_reader(errors, sender.clone(), IoEvent::ProviderLog, None);
+        Ok(Self { child })
+    }
+}
+
+impl Drop for ChildProcess {
+    fn drop(&mut self) {
+        let _ = self.child.kill();
+        let _ = self.child.wait();
+    }
+}
+
+pub struct McpBridge {
+    address: String,
+    token: String,
+}
+
+impl McpBridge {
+    pub fn start(sender: &mpsc::Sender<IoEvent>) -> Result<Self, String> {
+        let listener = TcpListener::bind("127.0.0.1:0")
+            .map_err(|error| format!("Could not bind the Anthracite MCP bridge: {error}"))?;
+        let address = listener
+            .local_addr()
+            .map_err(|error| format!("Could not inspect the Anthracite MCP bridge: {error}"))?
+            .to_string();
+        let token = uuid::Uuid::new_v4().to_string();
+        let expected_token = token.clone();
+        let sender = sender.clone();
+        thread::spawn(move || {
+            for stream in listener.incoming() {
+                let Ok(stream) = stream else {
+                    break;
+                };
+                let sender = sender.clone();
+                let expected_token = expected_token.clone();
+                thread::spawn(move || {
+                    if let Err(error) = serve_mcp_connection(stream, &expected_token, &sender) {
+                        let _ = sender.send(IoEvent::ProviderError(format!(
+                            "Anthracite MCP bridge: {error}"
+                        )));
+                    }
+                });
+            }
+        });
+        Ok(Self { address, token })
+    }
+
+    pub fn proxy_arguments(&self) -> Vec<String> {
+        vec![
+            "--mcp-proxy".to_string(),
+            self.address.clone(),
+            self.token.clone(),
+        ]
+    }
+}
+
+fn serve_mcp_connection(
+    stream: TcpStream,
+    expected_token: &str,
+    sender: &mpsc::Sender<IoEvent>,
+) -> Result<(), String> {
+    let reader_stream = stream
+        .try_clone()
+        .map_err(|error| format!("could not clone connection: {error}"))?;
+    let mut reader = BufReader::new(reader_stream);
+    let mut writer = stream;
+    let mut authentication = String::new();
+    reader
+        .read_line(&mut authentication)
+        .map_err(|error| format!("could not read authentication: {error}"))?;
+    if authentication.trim_end() != expected_token {
+        return Err("proxy authentication failed".to_string());
+    }
+
+    for line in reader.lines() {
+        let line = line.map_err(|error| format!("could not read proxy message: {error}"))?;
+        let message: Value = serde_json::from_str(&line)
+            .map_err(|error| format!("proxy sent invalid JSON: {error}"))?;
+        if let Some(value) = basic_mcp_response(&message) {
+            serde_json::to_writer(&mut writer, &value)
+                .map_err(|error| format!("could not encode MCP response: {error}"))?;
+            writer
+                .write_all(b"\n")
+                .and_then(|()| writer.flush())
+                .map_err(|error| format!("could not write MCP response: {error}"))?;
+            continue;
+        }
+        let response = message.get("id").map(|_| {
+            let (response_sender, response_receiver) = mpsc::channel();
+            (response_sender, response_receiver)
+        });
+        sender
+            .send(IoEvent::McpMessage {
+                message,
+                response: response.as_ref().map(|(sender, _)| sender.clone()),
+            })
+            .map_err(|_| "runtime closed while handling MCP message".to_string())?;
+        if let Some((_, receiver)) = response {
+            let value = receiver
+                .recv()
+                .map_err(|_| "runtime closed before responding to MCP".to_string())?;
+            serde_json::to_writer(&mut writer, &value)
+                .map_err(|error| format!("could not encode MCP response: {error}"))?;
+            writer
+                .write_all(b"\n")
+                .and_then(|()| writer.flush())
+                .map_err(|error| format!("could not write MCP response: {error}"))?;
+        }
+    }
+    Ok(())
+}
+
+fn basic_mcp_response(message: &Value) -> Option<Value> {
+    let id = message.get("id")?.clone();
+    match message.get("method").and_then(Value::as_str).unwrap_or("") {
+        "initialize" => Some(serde_json::json!({
+            "jsonrpc": "2.0",
+            "id": id,
+            "result": {
+                "protocolVersion": message
+                    .pointer("/params/protocolVersion")
+                    .and_then(Value::as_str)
+                    .unwrap_or("2025-06-18"),
+                "capabilities": {"tools": {}},
+                "serverInfo": {
+                    "name": "anthracite",
+                    "version": env!("CARGO_PKG_VERSION")
+                }
+            }
+        })),
+        "ping" => Some(serde_json::json!({"jsonrpc": "2.0", "id": id, "result": {}})),
+        "tools/list" => Some(serde_json::json!({
+            "jsonrpc": "2.0",
+            "id": id,
+            "result": {
+                "tools": [{
+                    "name": "freecad",
+                    "description": concat!(
+                        "Execute ordinary Python inside the active FreeCAD GUI. ",
+                        "App/FreeCAD, Gui, doc, and cad are prebound. The complete ",
+                        "source runs as one transaction, recomputes and validates, ",
+                        "then returns a structured CAD observation."
+                    ),
+                    "inputSchema": {
+                        "type": "object",
+                        "properties": {
+                            "code": {
+                                "type": "string",
+                                "description": "Complete ordinary FreeCAD Python source."
+                            }
+                        },
+                        "required": ["code"],
+                        "additionalProperties": false
+                    }
+                }]
+            }
+        })),
+        _ => None,
+    }
+}
+
+pub fn run_mcp_proxy(address: &str, token: &str) -> Result<(), String> {
+    let stream = TcpStream::connect(address)
+        .map_err(|error| format!("Could not connect to Anthracite MCP bridge: {error}"))?;
+    let mut writer = stream
+        .try_clone()
+        .map_err(|error| format!("Could not clone Anthracite MCP connection: {error}"))?;
+    writer
+        .write_all(format!("{token}\n").as_bytes())
+        .and_then(|()| writer.flush())
+        .map_err(|error| format!("Could not authenticate Anthracite MCP proxy: {error}"))?;
+
+    let output_thread = thread::spawn(move || -> Result<(), String> {
+        let stdout = std::io::stdout();
+        let mut output = stdout.lock();
+        for line in BufReader::new(stream).lines() {
+            let line = line.map_err(|error| format!("Could not read MCP response: {error}"))?;
+            output
+                .write_all(line.as_bytes())
+                .and_then(|()| output.write_all(b"\n"))
+                .and_then(|()| output.flush())
+                .map_err(|error| format!("Could not write MCP response: {error}"))?;
+        }
+        Ok(())
+    });
+
+    for line in std::io::stdin().lock().lines() {
+        let line = line.map_err(|error| format!("Could not read MCP request: {error}"))?;
+        writer
+            .write_all(line.as_bytes())
+            .and_then(|()| writer.write_all(b"\n"))
+            .and_then(|()| writer.flush())
+            .map_err(|error| format!("Could not forward MCP request: {error}"))?;
+    }
+    output_thread
+        .join()
+        .map_err(|_| "Anthracite MCP output thread panicked.".to_string())?
+}
