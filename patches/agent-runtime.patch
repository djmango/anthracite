+        assert!(emitter.call_tool(call).is_err());
+        assert!(emitter.finish_tool(&json!(1), r#"{"ok":true}"#).is_err());
+        let id = emitter.operations.borrow()["1"]["operationId"].clone();
+        let mut preparation =
+            json!({"requestId": 1, "operationId": "wrong", "context": {"revision": 0}});
+        assert!(emitter.prepare_tool(&preparation).is_err());
