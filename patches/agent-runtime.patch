+// SPDX-License-Identifier: LGPL-2.1-or-later
+use std::io::Write;
+use std::sync::atomic::{AtomicBool, Ordering};
+
+static INTERRUPTED: AtomicBool = AtomicBool::new(false);
+static TERMINATED: AtomicBool = AtomicBool::new(false);
+
+extern "C" fn signal(number: libc::c_int) {
+    if number == libc::SIGINT {
+        INTERRUPTED.store(true, Ordering::Relaxed);
+    } else {
+        TERMINATED.store(true, Ordering::Relaxed);
+    }
+}
+
+fn main() {
+    if let Ok(code) = std::env::var("ANTHRACITE_EXIT_CODE") {
+        std::process::exit(code.parse().unwrap());
+    }
+    let mut log =
+        std::fs::File::create(std::env::var_os("ANTHRACITE_SIGNAL_LOG").unwrap()).unwrap();
+    let stubborn = std::env::var_os("ANTHRACITE_STUBBORN").is_some();
+    unsafe {
+        let mut action: libc::sigaction = std::mem::zeroed();
+        action.sa_sigaction = signal as *const () as usize;
+        libc::sigemptyset(&mut action.sa_mask);
+        assert_eq!(
+            libc::sigaction(libc::SIGINT, &action, std::ptr::null_mut()),
+            0
+        );
+        assert_eq!(
+            libc::sigaction(libc::SIGTERM, &action, std::ptr::null_mut()),
+            0
+        );
+    }
+    writeln!(log, "READY {}", std::process::id()).unwrap();
+    loop {
+        if INTERRUPTED.swap(false, Ordering::Relaxed) {
+            writeln!(log, "INT").unwrap();
+        }
+        if TERMINATED.swap(false, Ordering::Relaxed) {
+            writeln!(log, "TERM").unwrap();
+            if !stubborn {
+                return;
+            }
+        }
+        std::thread::sleep(std::time::Duration::from_millis(10));
+    }
+}
