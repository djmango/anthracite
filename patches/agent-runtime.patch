+    fn cad_details_copy_exact_python_and_readable_json_without_display_labels() {
+        let mut timeline = Timeline::default();
+        let source = "cad.action('Resize')\ndoc.getObject('Pad').Length = 12";
+        timeline.apply("tool.activity", &json!({"arguments":{"code":source}}));
+        assert_eq!(timeline.rows[0]["content"], source);
+        timeline.apply(
+            "tool.observation",
+            &json!({"result":"{\"ok\":false,\"rolledBack\":true}"}),
+        );
+        assert_eq!(timeline.rows[1]["title"], "FreeCAD result · rolled back");
+        assert_eq!(
+            serde_json::from_str::<Value>(timeline.rows[1]["content"].as_str().unwrap()).unwrap(),
+            json!({"ok":false,"rolledBack":true})
+        );
+    }
+
+    #[test]
+    fn history_and_work_details_are_bounded_and_read_only() {
+        let mut timeline = Timeline::default();
+        for _ in 0..75 {
+            timeline.apply("content.user", &json!({"text":"Inspect"}));
+            for _ in 0..25 {
+                timeline.apply(
+                    "tool.observation",
+                    &json!({"result":"ok", "images":["large-image-bytes"]}),
+                );
+            }
+            timeline.apply("turn.completed", &json!({"status":"completed"}));
+        }
+        let snapshot = timeline.snapshot();
+        assert_eq!(snapshot["rows"].as_array().unwrap().len(), 60);
+        assert_eq!(snapshot["hasEarlier"], true);
+        let compact = Timeline::transport(snapshot.clone());
+        assert!(!compact.to_string().contains("large-image-bytes"));
+        let before = compact["rows"][0]["id"].as_str().unwrap();
+        let page = timeline.earlier(before);
+        assert_eq!(page["rows"].as_array().unwrap().len(), 60);
+        assert_eq!(timeline.earlier("missing")["hasEarlier"], false);
+        let work = compact["rows"][1]["id"].as_str().unwrap();
+        assert_eq!(compact["rows"][1]["entryCount"], 50);
+        assert_eq!(
+            timeline.details(work, 0)["entries"]
+                .as_array()
+                .unwrap()
+                .len(),
+            20
+        );
+        assert_eq!(
+            timeline.details(work, 40)["entries"]
+                .as_array()
+                .unwrap()
+                .len(),
+            10
+        );
+        assert_eq!(timeline.details(work, usize::MAX)["entries"], json!([]));
+        assert_eq!(timeline.snapshot(), snapshot);
+    }
+
+    #[test]
+    fn groups_only_last_message_and_preserves_images_and_exact_elapsed_time() {
+        let events = [
+            (
+                "content.user",
+                json!({"text":"Make a box", "timestampMs":1000}),
+            ),
+            (
+                "content.delta",
+                json!({"streamKind":"assistant_text", "messageId":"progress", "text":"Checking"}),
+            ),
+            (
+                "tool.observation",
+                json!({"result":"ok", "images":["data:image/png;base64,exact"]}),
+            ),
+            (
+                "content.delta",
+                json!({"streamKind":"assistant_text", "messageId":"final", "text":"Done"}),
+            ),
+            (
+                "content.delta",
+                json!({"streamKind":"assistant_text", "messageId":"final", "text":"."}),
+            ),
+            (
+                "turn.completed",
+                json!({"status":"completed", "timestampMs":138000}),
+            ),
+        ];
+        let mut live = Timeline::default();
+        let mut replay = Timeline::default();
+        for (event, payload) in &events {
+            live.apply(event, payload);
+        }
+        for (event, payload) in &events {
+            replay.apply(event, payload);
+        }
+        assert_eq!(live.snapshot(), replay.snapshot());
+        let work = &live.rows[1];
+        assert_eq!(work["author"], "Worked for 2m 17s");
+        assert_eq!(work["body"], "Done.");
+        assert_eq!(work["entries"][0]["body"], "Checking");
+        assert_eq!(work["entries"][2]["body"], "data:image/png;base64,exact");
+        assert!(live.apply("turn.completed", &events[5].1).is_empty());
+    }
+
+    #[test]
+    fn failed_interrupted_and_followup_runs_do_not_promote_intermediate_text() {
+        for terminal in ["failed", "interrupted"] {
+            let mut timeline = Timeline::default();
+            timeline.apply("content.user", &json!({"text":"First", "timestampMs":2000}));
+            timeline.apply(
+                "content.delta",
+                &json!({"streamKind":"assistant_text", "text":"Working"}),
+            );
+            timeline.apply(
+                "turn.completed",
+                &json!({"status":terminal, "timestampMs":1000}),
+            );
+            assert_eq!(timeline.rows[1]["body"], "");
+            assert_eq!(timeline.rows[1]["author"], "Worked for 0m 0s");
+            timeline.apply("content.user", &json!({"text":"Next", "timestampMs":3000}));
+            timeline.apply(
+                "content.delta",
+                &json!({"streamKind":"assistant_text", "text":"Final"}),
+            );
+            timeline.apply(
+                "turn.completed",
+                &json!({"status":"completed", "timestampMs":4000}),
+            );
+            assert_eq!(timeline.rows.len(), 4);
+            assert_eq!(timeline.rows[3]["body"], "Final");
+        }
+    }
