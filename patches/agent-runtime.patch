+
+fn now_ms() -> i64 {
+    SystemTime::now()
+        .duration_since(UNIX_EPOCH)
+        .unwrap_or_default()
+        .as_millis()
+        .try_into()
+        .unwrap_or(i64::MAX)
+}
+
+fn new_id(prefix: &str) -> String {
+    format!("{prefix}-{}", Uuid::new_v4())
+}
+
+fn canonical_path(path: &str) -> Option<String> {
+    if path.is_empty() {
+        return None;
+    }
+    let path = Path::new(path);
+    path.canonicalize()
+        .ok()
+        .or_else(|| Some(path.to_path_buf()))
+        .map(|path| path.to_string_lossy().into_owned())
+}
+
+fn fingerprint(path: &str) -> Option<String> {
+    let mut file = File::open(path).ok()?;
+    let mut digest = Sha256::new();
+    let mut buffer = [0_u8; 64 * 1024];
+    loop {
+        let count = file.read(&mut buffer).ok()?;
+        if count == 0 {
+            break;
+        }
+        digest.update(&buffer[..count]);
+    }
+    Some(format!("{:x}", digest.finalize()))
+}
+
+pub struct Store {
+    connection: Connection,
+    document_id: String,
+    thread_id: String,
+    provider: String,
+    event_log: PathBuf,
+    // One runtime owns this database, including crash recovery. OS releases on exit.
+    _lock: File,
+}
+
+impl Store {
+    pub fn open(
+        database_path: &str,
+        document: &Value,
+        provider: &str,
+        requested_thread_id: Option<&str>,
+        create_thread: bool,
+    ) -> Result<Self, String> {
+        let path = PathBuf::from(database_path);
+        if let Some(parent) = path.parent() {
+            std::fs::create_dir_all(parent).map_err(|error| {
+                format!(
+                    "Could not create Anthracite data directory {}: {error}",
+                    parent.display()
+                )
+            })?;
+        }
+
+        let lock = OpenOptions::new()
+            .create(true)
+            .truncate(false)
+            .write(true)
+            .open(path.with_extension("runtime.lock"))
+            .map_err(|e| e.to_string())?;
+        lock.try_lock()
+            .map_err(|e| format!("Anthracite database is already in use: {e}"))?;
+        let connection = Connection::open(database_path)
+            .map_err(|error| format!("Could not open Anthracite SQLite database: {error}"))?;
+        connection
+            .busy_timeout(std::time::Duration::from_secs(5))
+            .map_err(|e| e.to_string())?;
+        connection.set_prepared_statement_cache_capacity(32);
+        let mut store = Self {
+            connection,
+            document_id: String::new(),
+            thread_id: String::new(),
+            provider: provider.to_owned(),
+            event_log: path.with_extension("events.jsonl"),
+            _lock: lock,
+        };
+        store.prepare_sqlite()?;
+        store.migrate()?;
+        store.transaction(|| {
+            store
+                .execute(
+                    "UPDATE operations SET status = 'unknown', updated_at_ms = ?1
+                 WHERE status IN ('pending', 'running')",
+                    params![now_ms()],
+                )
+                .map_err(|e| e.to_string())?;
+            Ok(())
+        })?;
+        store.document_id = store.transaction(|| store.resolve_document(document))?;
+        store.thread_id =
+            store.transaction(|| store.resolve_thread(requested_thread_id, create_thread))?;
+        Ok(store)
+    }
+
+    fn transaction<T>(&self, action: impl FnOnce() -> Result<T, String>) -> Result<T, String> {
+        let transaction =
+            rusqlite::Transaction::new_unchecked(&self.connection, TransactionBehavior::Immediate)
+                .map_err(|error| error.to_string())?;
+        match action() {
+            Ok(value) => {
+                transaction.commit().map_err(|error| error.to_string())?;
+                Ok(value)
+            }
+            Err(error) => {
+                transaction.rollback().map_err(|rollback| {
+                    format!("Database rollback failed: {rollback}; original error: {error}")
+                })?;
+                Err(error)
+            }
+        }
+    }
+
+    fn prepare_sqlite(&self) -> Result<(), String> {
+        let mode = self.query_string("PRAGMA journal_mode = WAL", ())?;
+        if mode.as_deref() != Some("wal") {
+            return Err("Could not enable SQLite WAL mode".into());
+        }
+        // The operation journal must be durable before Python is authorized to run.
+        self.connection
+            .execute_batch("PRAGMA synchronous = FULL; PRAGMA foreign_keys = ON;")
+            .map_err(|error| error.to_string())
+    }
+
+    fn migrate(&self) -> Result<(), String> {
+        self.connection
+            .execute_batch("PRAGMA foreign_keys = ON")
+            .map_err(|e| e.to_string())?;
+        self.transaction(|| {
+            let exists = self
+                .query_string(
+                    "SELECT name FROM sqlite_master WHERE name = 'anthracite_schema'",
+                    (),
+                )?
+                .is_some();
+            if !exists {
+                self.connection
+                    .execute_batch(MIGRATION)
+                    .map_err(|e| e.to_string())?;
+            }
+            if self
+                .query_string("SELECT CAST(COUNT(*) AS TEXT) FROM anthracite_schema", ())?
+                .as_deref()
+                != Some("1")
+            {
+                return Err("Invalid Anthracite schema version table".into());
+            }
+            let version = self
+                .query_string("SELECT CAST(version AS TEXT) FROM anthracite_schema", ())?
+                .ok_or("Missing schema version")?;
+            match version.as_str() {
+                "1" => self
+                    .connection
+                    .execute_batch(OPERATIONS_MIGRATION)
+                    .map_err(|e| e.to_string())?,
+                "2" => {}
+                _ => return Err(format!("Unsupported Anthracite schema version: {version}")),
+            }
+            Ok(())
+        })
+    }
+
+    pub fn begin_operation(&self, payload: &Value) -> Result<String, String> {
+        let code = payload
+            .pointer("/arguments/code")
+            .and_then(Value::as_str)
+            .filter(|code| !code.trim().is_empty())
+            .ok_or("Missing FreeCAD Python source")?;
+        let id = new_id("operation");
+        let mut event = payload.clone();
+        event["operationId"] = json!(id);
+        self.transaction(|| {
+            self.execute(
+                "INSERT INTO operations(id, document_id, thread_id, provider, request_id_json,
+                 turn_id, python_source, status, created_at_ms, updated_at_ms)
+                 VALUES (?1, ?2, ?3, ?4, ?5, ?6, ?7, 'pending', ?8, ?8)",
+                params![
+                    id.clone(),
+                    self.document_id.clone(),
+                    self.thread_id.clone(),
+                    self.provider.clone(),
+                    payload["requestId"].to_string(),
+                    payload["turnId"].as_str(),
+                    code,
+                    now_ms()
+                ],
+            )
+            .map_err(|e| e.to_string())?;
+            self.record_inner("tool.call", &event)?;
+            Ok(())
+        })?;
+        self.project("tool.call", &event);
+        Ok(id)
+    }
+
+    pub fn prepare_operation(&self, id: &str, context: &Value) -> Result<(), String> {
+        if !context["revision"]
+            .as_i64()
+            .is_some_and(|revision| revision >= 0)
+        {
+            return Err("Missing or invalid prepared document revision".into());
+        }
+        self.transaction(|| {
+            let status = self.query_string(
+                "SELECT status FROM operations WHERE id = ?1 AND thread_id = ?2",
+                params![id, self.thread_id.clone()],
+            )?;
+            if status.as_deref() != Some("pending") {
+                return Err("Operation is not pending; never replay it".into());
+            }
+            self.execute(
+                "UPDATE operations SET status = 'running', revision_before = ?1,
+                 document_context_json = ?2, updated_at_ms = ?3 WHERE id = ?4",
+                params![
+                    context["revision"].as_i64(),
+                    context.to_string(),
+                    now_ms(),
+                    id
+                ],
+            )
+            .map_err(|e| e.to_string())?;
+            Ok(())
+        })
+    }
+
+    pub fn finish_operation(&self, id: &str, result: &str) -> Result<(), String> {
+        let observation: Value =
+            serde_json::from_str(result).map_err(|e| format!("Invalid executor result: {e}"))?;
+        let status = if observation["requiresInspection"] == true {
+            "unknown"
+        } else if observation["ok"] == true {
+            "committed"
+        } else if observation["rolledBack"] == true {
+            "rolled_back"
+        } else if observation["notExecuted"] == true || observation["conflict"] == true {
+            "rejected"
+        } else {
+            "unknown"
+        };
+        self.transaction(|| {
+            let old = self.query_string(
+                "SELECT status FROM operations WHERE id = ?1 AND thread_id = ?2",
+                params![id, self.thread_id.clone()],
+            )?;
+            if !matches!(old.as_deref(), Some("pending" | "running")) {
+                return Err("Operation has already finished or is unknown; never replay it".into());
+            }
+            if old.as_deref() == Some("pending") && matches!(status, "committed" | "rolled_back") {
+                return Err("Unprepared operation cannot have an execution outcome".into());
+            }
+            self.execute(
+                "UPDATE operations SET status = ?1, revision_after = ?2, result_json = ?3,
+                 updated_at_ms = ?4, revision_before = COALESCE(?6, revision_before) WHERE id = ?5",
+                params![
+                    status,
+                    observation["revision"].as_i64(),
+                    result,
+                    now_ms(),
+                    id,
+                    observation["revisionBefore"].as_i64()
+                ],
+            )
+            .map_err(|e| e.to_string())?;
+            self.record_inner(
+                "tool.result",
+                &json!({"operationId": id, "status": status, "result": observation}),
+            )?;
+            Ok(())
+        })?;
+        self.project(
+            "tool.result",
+            &json!({"operationId": id, "status": status, "result": observation}),
+        );
+        Ok(())
+    }
+
+    pub fn mark_operation_unknown(&self, id: &str) -> Result<(), String> {
+        self.execute(
+            "UPDATE operations SET status = 'unknown', updated_at_ms = ?1
+             WHERE id = ?2 AND thread_id = ?3 AND status = 'running'",
+            params![now_ms(), id, self.thread_id.clone()],
+        )
+        .map_err(|e| e.to_string())?;
+        Ok(())
+    }
+
+    pub fn unresolved_count(&self) -> Result<String, String> {
+        Ok(self.query_string("SELECT CAST(COUNT(*) AS TEXT) FROM operations WHERE document_id = ?1 AND status = 'unknown'",
+            params![self.document_id.clone()])?.unwrap_or_default())
+    }
+
+    fn execute(&self, sql: &str, parameters: impl Params) -> rusqlite::Result<usize> {
+        self.connection.prepare_cached(sql)?.execute(parameters)
+    }
+
+    fn query_string(&self, sql: &str, parameters: impl Params) -> Result<Option<String>, String> {
+        self.connection
+            .prepare_cached(sql)
+            .and_then(|mut statement| statement.query_row(parameters, |row| row.get(0)).optional())
+            .map_err(|error| error.to_string())
+    }
+
+    fn resolve_document(&self, document: &Value) -> Result<String, String> {
+        let raw_path = document.get("path").and_then(Value::as_str).unwrap_or("");
+        let path = canonical_path(raw_path);
+        let session_key = document
+            .get("sessionKey")
+            .and_then(Value::as_str)
+            .filter(|value| !value.is_empty())
+            .map(str::to_owned);
+        let display_name = document
+            .get("displayName")
+            .and_then(Value::as_str)
+            .filter(|value| !value.is_empty())
+            .unwrap_or("Unsaved FreeCAD document");
+        let file_fingerprint = path.as_deref().and_then(fingerprint);
+        let session_document_id = match &session_key {
+            Some(session_key) => self.query_string(
+                "SELECT id FROM documents WHERE session_key = ?1 LIMIT 1",
+                params![session_key.as_str()],
+            )?,
+            None => None,
+        };
+
+        if let Some(path) = &path
+            && let Some(id) = self.query_string(
+                "SELECT id FROM documents WHERE canonical_path = ?1 LIMIT 1",
+                params![path.as_str()],
+            )?
+        {
+            if let Some(session_document_id) = &session_document_id
+                && session_document_id != &id
+            {
+                self.execute(
+                    "UPDATE documents SET session_key = NULL WHERE id = ?1",
+                    params![session_document_id.as_str()],
+                )
+                .map_err(|error| error.to_string())?;
+            }
+            self.execute(
+                "UPDATE documents
+                     SET session_key = ?1, fingerprint = ?2,
+                         display_name = ?3, updated_at_ms = ?4
+                     WHERE id = ?5",
+                params![
+                    session_key,
+                    file_fingerprint,
+                    display_name,
+                    now_ms(),
+                    id.clone()
+                ],
+            )
+            .map_err(|error| error.to_string())?;
+            return Ok(id);
+        }
+
+        if let Some(id) = session_document_id {
+            if let Some(path) = &path {
+                self.execute(
+                    "UPDATE documents
+                         SET canonical_path = ?1, fingerprint = ?2,
+                             display_name = ?3, updated_at_ms = ?4
+                         WHERE id = ?5",
+                    params![
+                        path.as_str(),
+                        file_fingerprint,
+                        display_name,
+                        now_ms(),
+                        id.clone()
+                    ],
+                )
+                .map_err(|error| error.to_string())?;
+            }
+            return Ok(id);
+        }
+
+        if let (Some(path), Some(file_fingerprint)) = (&path, &file_fingerprint) {
+            let matches = (|| {
+                let mut statement = self.connection.prepare_cached(
+                    "SELECT id, canonical_path
+                             FROM documents
+                             WHERE fingerprint = ?1
+                             LIMIT 2",
+                )?;
+                let mut rows = statement.query(params![file_fingerprint.as_str()])?;
+                let mut matches = Vec::new();
+                while let Some(row) = rows.next()? {
+                    matches.push((row.get::<_, String>(0)?, row.get::<_, String>(1)?));
+                }
+                Ok::<_, rusqlite::Error>(matches)
+            })()
+            .map_err(|error| error.to_string())?;
+            if matches.len() == 1 && !Path::new(&matches[0].1).exists() {
+                let id = matches[0].0.clone();
+                self.execute(
+                    "UPDATE documents
+                         SET canonical_path = ?1, session_key = ?2,
+                             display_name = ?3, updated_at_ms = ?4
+                         WHERE id = ?5",
+                    params![
+                        path.as_str(),
+                        session_key,
+                        display_name,
+                        now_ms(),
+                        id.clone()
+                    ],
+                )
+                .map_err(|error| error.to_string())?;
+                return Ok(id);
+            }
+        }
+
+        let id = new_id("document");
+        let timestamp = now_ms();
+        self.execute(
+            "INSERT INTO documents(
+                    id, canonical_path, session_key, fingerprint, display_name,
+                    created_at_ms, updated_at_ms
+                 ) VALUES (?1, ?2, ?3, ?4, ?5, ?6, ?7)",
+            params![
+                id.clone(),
+                path,
+                session_key,
+                file_fingerprint,
+                display_name,
+                timestamp,
+                timestamp
+            ],
+        )
+        .map_err(|error| error.to_string())?;
+        Ok(id)
+    }
+
+    fn resolve_thread(
+        &self,
+        requested_thread_id: Option<&str>,
+        create_thread: bool,
+    ) -> Result<String, String> {
+        if !create_thread {
+            if let Some(requested_thread_id) = requested_thread_id.filter(|value| !value.is_empty())
+            {
+                return self
+                    .query_string(
+                        "SELECT id
+                         FROM threads
+                         WHERE id = ?1 AND document_id = ?2
+                           AND provider = ?3 AND archived = 0
+                         LIMIT 1",
+                        params![
+                            requested_thread_id,
+                            self.document_id.clone(),
+                            self.provider.clone()
+                        ],
+                    )?
+                    .ok_or_else(|| {
+                        "The selected conversation does not belong to this document.".to_string()
+                    });
+            }
+
+            if let Some(id) = self.query_string(
+                "SELECT id
+                 FROM threads
+                 WHERE document_id = ?1 AND provider = ?2 AND archived = 0
+                 ORDER BY updated_at_ms DESC
+                 LIMIT 1",
+                params![self.document_id.clone(), self.provider.clone()],
+            )? {
+                return Ok(id);
+            }
+        }
+
+        let id = new_id("thread");
+        let timestamp = now_ms();
+        self.execute(
+            "INSERT INTO threads(
+                    id, document_id, provider, title, created_at_ms, updated_at_ms
+                 ) VALUES (?1, ?2, ?3, ?4, ?5, ?6)",
+            params![
+                id.clone(),
+                self.document_id.clone(),
+                self.provider.clone(),
+                "New conversation",
+                timestamp,
+                timestamp
+            ],
+        )
+        .map_err(|error| error.to_string())?;
+        Ok(id)
+    }
+
+    pub fn local_thread_id(&self) -> &str {
+        &self.thread_id
+    }
+
+    pub fn threads(&self) -> Result<Vec<Value>, String> {
+        (|| {
+            let mut statement = self.connection.prepare_cached(
+                "SELECT id, title, updated_at_ms
+                         FROM threads
+                         WHERE document_id = ?1 AND provider = ?2 AND archived = 0
+                         ORDER BY updated_at_ms DESC",
+            )?;
+            let mut rows =
+                statement.query(params![self.document_id.clone(), self.provider.clone()])?;
+            let mut threads = Vec::new();
+            while let Some(row) = rows.next()? {
+                let id = row.get::<_, String>(0)?;
+                threads.push(json!({
+                    "id": id,
+                    "title": row.get::<_, String>(1)?,
+                    "updatedAtMs": row.get::<_, i64>(2)?,
+                    "current": id == self.thread_id
+                }));
+            }
+            Ok::<_, rusqlite::Error>(threads)
+        })()
+        .map_err(|error| error.to_string())
+    }
+
+    pub fn provider_thread_id(&self) -> Result<Option<String>, String> {
+        self.query_string(
+            "SELECT provider_thread_id
+             FROM threads
+             WHERE id = ?1 AND provider_thread_id IS NOT NULL",
+            params![self.thread_id.clone()],
+        )
+    }
+
+    pub fn set_provider_thread_id(&self, provider_thread_id: &str) -> Result<(), String> {
+        self.execute(
+            "UPDATE threads
+                 SET provider_thread_id = ?1, updated_at_ms = ?2
+                 WHERE id = ?3",
+            params![provider_thread_id, now_ms(), self.thread_id.clone()],
+        )
+        .map_err(|error| error.to_string())?;
+        Ok(())
+    }
+
+    pub fn draft(&self) -> Result<String, String> {
+        Ok(self
+            .query_string(
+                "SELECT body FROM drafts WHERE thread_id = ?1 LIMIT 1",
+                params![self.thread_id.clone()],
+            )?
+            .unwrap_or_default())
+    }
+
+    pub fn save_draft(&self, body: &str) -> Result<(), String> {
+        if body.is_empty() {
+            self.execute(
+                "DELETE FROM drafts WHERE thread_id = ?1",
+                params![self.thread_id.clone()],
+            )
+            .map_err(|error| error.to_string())?;
+        } else {
+            self.execute(
+                "INSERT INTO drafts(thread_id, body, updated_at_ms)
+                     VALUES (?1, ?2, ?3)
+                     ON CONFLICT(thread_id) DO UPDATE SET
+                         body = excluded.body,
+                         updated_at_ms = excluded.updated_at_ms",
+                params![self.thread_id.clone(), body, now_ms()],
+            )
+            .map_err(|error| error.to_string())?;
+        }
+        Ok(())
+    }
+
+    pub fn model_selection(&self) -> Result<Value, String> {
+        (|| {
+            let mut statement = self.connection.prepare_cached(
+                "SELECT model, effort
+                         FROM thread_settings
+                         WHERE thread_id = ?1
+                         LIMIT 1",
+            )?;
+            let mut rows = statement.query(params![self.thread_id.clone()])?;
+            Ok::<_, rusqlite::Error>(match rows.next()? {
+                Some(row) => json!({
+                    "model": row.get::<_, String>(0)?,
+                    "effort": row.get::<_, String>(1)?
+                }),
+                None => json!({"model": "", "effort": ""}),
+            })
+        })()
+        .map_err(|error| error.to_string())
+    }
+
+    pub fn save_model_selection(&self, model: &str, effort: &str) -> Result<(), String> {
+        self.execute(
+            "INSERT INTO thread_settings(thread_id, model, effort, updated_at_ms)
+                 VALUES (?1, ?2, ?3, ?4)
+                 ON CONFLICT(thread_id) DO UPDATE SET
+                     model = excluded.model,
+                     effort = excluded.effort,
+                     updated_at_ms = excluded.updated_at_ms",
+            params![self.thread_id.clone(), model, effort, now_ms()],
+        )
+        .map_err(|error| error.to_string())?;
+        Ok(())
+    }
+
+    pub fn record(&self, event_type: &str, payload: &Value) -> Result<(), String> {
+        self.transaction(|| self.record_inner(event_type, payload))?;
+        self.project(event_type, payload);
+        Ok(())
+    }
+
+    fn record_inner(&self, event_type: &str, payload: &Value) -> Result<(), String> {
+        let timestamp = now_ms();
+        let turn_id = payload
+            .get("turnId")
+            .and_then(Value::as_str)
+            .map(str::to_owned);
+        self.execute(
+            "INSERT INTO events(
+                    thread_id, turn_id, event_type, payload_json, created_at_ms
+                 ) VALUES (?1, ?2, ?3, ?4, ?5)",
+            params![
+                self.thread_id.clone(),
+                turn_id,
+                event_type,
+                payload.to_string(),
+                timestamp
+            ],
+        )
+        .map_err(|error| error.to_string())?;
+        if event_type == "content.user"
+            && let Some(text) = payload.get("text").and_then(Value::as_str)
+        {
+            self.execute(
+                "UPDATE threads SET title = ?1 WHERE id = ?2 AND title = 'New conversation'",
+                params![
+                    text.chars().take(80).collect::<String>(),
+                    self.thread_id.clone()
+                ],
+            )
+            .map_err(|e| e.to_string())?;
+        }
+        self.execute(
+            "UPDATE threads SET updated_at_ms = ?1 WHERE id = ?2",
+            params![timestamp, self.thread_id.clone()],
+        )
+        .map_err(|e| e.to_string())?;
+        Ok(())
+    }
+
+    fn project(&self, event_type: &str, payload: &Value) {
+        let timestamp = now_ms();
+        // A readable live projection; SQLite remains authoritative for recovery.
+        // Projection failure must not turn a committed event into an apparent failure.
+        let record = json!({
+            "threadId": self.thread_id,
+            "documentId": self.document_id,
+            "provider": self.provider,
+            "type": event_type,
+            "timestampMs": timestamp,
+            "payload": payload,
+        });
+        let mut options = OpenOptions::new();
+        options.create(true).append(true);
+        #[cfg(unix)]
+        {
+            use std::os::unix::fs::OpenOptionsExt;
+            options.mode(0o600);
+        }
+        if let Err(error) = options
+            .open(&self.event_log)
+            .and_then(|mut file| file.write_all(format!("{record}\n").as_bytes()))
+        {
+            eprintln!(
+                "Anthracite event projection {}: {error}",
+                self.event_log.display()
+            );
+        }
+    }
+
+    pub fn history(&self) -> Result<Vec<Value>, String> {
+        let mut events = (|| {
+            let mut statement = self.connection.prepare_cached(
+                "SELECT event_type, payload_json, created_at_ms
+                         FROM events
+                         WHERE thread_id = ?1
+                           AND event_type IN (
+                               'content.user',
+                               'content.delta',
+                               'item.started',
+                               'item.completed',
+                               'tool.activity',
+                               'tool.observation',
+                               'turn.completed',
+                               'plan.updated',
+                               'runtime.warning',
+                               'runtime.error'
+                           )
+                         ORDER BY id DESC",
+            )?;
+            let mut rows = statement.query(params![self.thread_id.clone()])?;
+            let mut events = Vec::new();
+            while let Some(row) = rows.next()? {
+                let event_type = row.get::<_, String>(0)?;
+                let payload = row.get::<_, String>(1)?;
+                let mut payload = serde_json::from_str::<Value>(&payload).unwrap_or(json!({}));
+                if payload.get("timestampMs").is_none() {
+                    payload["timestampMs"] = json!(row.get::<_, i64>(2)?);
+                }
+                events.push(json!({
+                    "type": event_type,
+                    "payload": payload
+                }));
+            }
+            Ok::<_, rusqlite::Error>(events)
+        })()
+        .map_err(|error| error.to_string())?;
+        events.reverse();
+        Ok(events)
+    }
+
+    pub fn summary(&self) -> Value {
+        json!({
+            "localThreadId": self.local_thread_id(),
+            "documentId": self.document_id,
+            "provider": self.provider
+        })
+    }
+}
