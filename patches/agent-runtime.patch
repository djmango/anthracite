+// SPDX-License-Identifier: LGPL-2.1-or-later
+
+//! Provider-independent conversation projection. Qt only applies these row edits.
+//! The same reducer consumes live events and the persisted event history.
+use serde_json::{Value, json};
+
+#[derive(Default)]
+pub struct Timeline {
+    rows: Vec<Value>,
+    next_id: u64,
+    run: Option<(usize, u64)>,
+    assistant: Option<(String, usize)>,
+    reasoning: Option<(String, usize)>,
+    plan: Option<usize>,
+}
+
+fn text(value: &Value, key: &str) -> String {
+    value[key].as_str().unwrap_or_default().to_owned()
+}
+
+impl Timeline {
+    pub fn snapshot(&self) -> Value {
+        let start = self.rows.len().saturating_sub(60);
+        json!({"op": "reset", "rows": self.rows[start..], "hasEarlier": start > 0})
+    }
+
+    pub fn earlier(&self, before: &str) -> Value {
+        let end = self
+            .rows
+            .iter()
+            .position(|row| row["id"] == before)
+            .unwrap_or(0);
+        let start = end.saturating_sub(60);
+        json!({"op":"prepend", "rows":self.rows[start..end], "hasEarlier":start > 0})
+    }
+
+    pub fn details(&self, id: &str, offset: usize) -> Value {
+        let entries = self
+            .rows
+            .iter()
+            .find(|row| row["id"] == id)
+            .and_then(|row| row["entries"].as_array());
+        let page: Vec<_> = entries
+            .into_iter()
+            .flatten()
+            .skip(offset)
+            .take(20)
+            .cloned()
+            .collect();
+        json!({"op":"details", "id":id, "offset":offset, "entries":page})
+    }
+
+    /// Work details (especially render bytes) cross the UI boundary only on demand.
+    pub fn transport(mut edit: Value) -> Value {
+        fn compact(row: &mut Value) {
+            if row["kind"] == "work" {
+                row["entryCount"] = json!(row["entries"].as_array().map_or(0, Vec::len));
+                row["entries"] = json!([]);
+            }
+        }
+        if let Some(rows) = edit["rows"].as_array_mut() {
+            for row in rows {
+                compact(row);
+            }
+        }
+        if let Some(row) = edit.get_mut("row") {
+            compact(row);
+        }
+        edit
+    }
+
+    fn append(
+        &mut self,
+        author: &str,
+        body: impl Into<String>,
+        kind: &str,
+        edits: &mut Vec<Value>,
+    ) {
+        self.next_id += 1;
+        let row = json!({"id": self.next_id.to_string(), "author": author,
+                         "body": body.into(), "kind": kind, "entries": []});
+        let mut row = row;
+        row["title"] = json!(
+            text(&row, "body")
+                .lines()
+                .next()
+                .unwrap_or(author)
+                .chars()
+                .take(120)
+                .collect::<String>()
+        );
+        self.rows.push(row.clone());
+        edits.push(json!({"op": "append", "row": row}));
+    }
+
+    fn update(&self, row: usize, edits: &mut Vec<Value>) {
+        edits.push(json!({"op": "update", "row": self.rows[row]}));
+    }
+
+    fn finish(&mut self, timestamp: u64, success: bool, edits: &mut Vec<Value>) {
+        let Some((start, began)) = self.run.take() else {
+            return;
+        };
+        let final_row = if success {
+            self.assistant.as_ref().map(|(_, row)| *row)
+        } else {
+            None
+        };
+        let answer = final_row
+            .map(|row| text(&self.rows[row], "body"))
+            .unwrap_or_default();
+        let entries: Vec<_> = self
+            .rows
+            .iter()
+            .enumerate()
+            .skip(start)
+            .filter(|(row, _)| Some(*row) != final_row)
+            .map(|(_, row)| row.clone())
+            .collect();
+        let ids: Vec<_> = self.rows[start..]
+            .iter()
+            .map(|row| row["id"].clone())
+            .collect();
+        self.rows.truncate(start);
+        edits.push(json!({"op": "remove", "ids": ids}));
+        let seconds = timestamp.saturating_sub(began) / 1000;
+        self.append(
+            &format!("Worked for {}m {}s", seconds / 60, seconds % 60),
+            answer,
+            "work",
+            edits,
+        );
+        self.rows.last_mut().unwrap()["entries"] = json!(entries);
+        // Include the work entries once, in the append, not in a second image-heavy update.
+        edits.last_mut().unwrap()["row"] = self.rows.last().unwrap().clone();
+        self.assistant = None;
+        self.reasoning = None;
+        self.plan = None;
+    }
+
+    pub fn apply(&mut self, event: &str, payload: &Value) -> Vec<Value> {
+        let mut edits = Vec::new();
+        let timestamp = payload["timestampMs"].as_u64().unwrap_or_default();
+        match event {
+            "content.user" => {
+                // A previous unfinished run is interrupted, never presented as a final answer.
+                if self.run.is_some() {
+                    self.append("Activity", "Interrupted", "activity", &mut edits);
+                    self.finish(timestamp, false, &mut edits);
+                }
+                self.append("You", text(payload, "text"), "user", &mut edits);
+                if let Some(attachments) = payload["attachments"].as_array() {
+                    for attachment in attachments {
+                        // CAD references already appear as inline tokens in the user message.
+                        if attachment["type"] == "cad" {
+                            continue;
+                        }
+                        let image = attachment["type"] == "image";
+                        self.append(
+                            &text(attachment, "name"),
+                            if image {
+                                text(attachment, "dataUrl")
+                            } else {
+                                text(attachment, "name")
+                            },
+                            if image { "image" } else { "user" },
+                            &mut edits,
+                        );
+                    }
+                }
+                self.run = Some((self.rows.len(), timestamp));
+            }
+            "content.delta" => {
+                let assistant = payload["streamKind"] == "assistant_text";
+                let id = text(payload, "messageId");
+                let stream = if assistant {
+                    &self.assistant
+                } else {
+                    &self.reasoning
+                };
+                let row = match stream {
+                    Some((previous, row)) if *previous == id => *row,
+                    _ => {
+                        let row = self.rows.len();
+                        self.append(
+                            if assistant { "Anthracite" } else { "Thinking" },
+                            "",
+                            if assistant { "assistant" } else { "activity" },
+                            &mut edits,
+                        );
+                        if assistant {
+                            self.assistant = Some((id, row));
+                        } else {
+                            self.reasoning = Some((id, row));
+                        }
+                        row
+                    }
+                };
+                self.rows[row]["body"] =
+                    json!(text(&self.rows[row], "body") + &text(payload, "text"));
+                self.update(row, &mut edits);
+            }
+            "tool.activity" => {
+                self.append(
+                    "Activity",
+                    format!("freecad\n{}", text(&payload["arguments"], "code")),
+                    "activity",
+                    &mut edits,
+                );
+                self.rows.last_mut().unwrap()["content"] =
+                    json!(text(&payload["arguments"], "code"));
+                edits.last_mut().unwrap()["row"] = self.rows.last().unwrap().clone();
+            }
+            "tool.observation" => {
+                let result = text(payload, "result");
+                let title = match serde_json::from_str::<Value>(&result) {
+                    Ok(value) if value["ok"] == true => "FreeCAD result · passed execution checks",
+                    Ok(value) if value["rolledBack"] == true => "FreeCAD result · rolled back",
+                    Ok(value) if value["ok"] == false => {
+                        "FreeCAD result · failed — inspect details"
+                    }
+                    _ => "FreeCAD result",
+                };
+                self.append(
+                    "Activity",
+                    format!("{title}\n{result}"),
+                    "activity",
+                    &mut edits,
+                );
+                self.rows.last_mut().unwrap()["content"] = json!(
+                    serde_json::from_str::<Value>(&result)
+                        .map(|value| serde_json::to_string_pretty(&value).unwrap())
+                        .unwrap_or(result)
+                );
+                edits.last_mut().unwrap()["row"] = self.rows.last().unwrap().clone();
+                if let Some(images) = payload["images"].as_array() {
+                    for image in images {
+                        self.append(
+                            image["view"].as_str().unwrap_or("Model image"),
+                            image
+                                .as_str()
+                                .map(str::to_owned)
+                                .unwrap_or_else(|| text(image, "dataUrl")),
+                            "image",
+                            &mut edits,
+                        );
+                    }
+                }
+            }
+            "item.started" | "item.completed" => {
+                let title = text(payload, "title");
+                let detail = text(payload, "detail");
+                self.append(
+                    "Activity",
+                    if detail.is_empty() {
+                        title
+                    } else {
+                        format!("{title}: {detail}")
+                    },
+                    "activity",
+                    &mut edits,
+                );
+                for field in ["input", "output"] {
+                    if !payload[field].is_null() {
+                        self.append(
+                            "Activity",
+                            payload[field]
+                                .as_str()
+                                .map(str::to_owned)
+                                .unwrap_or_else(|| {
+                                    serde_json::to_string_pretty(&payload[field]).unwrap()
+                                }),
+                            "activity",
+                            &mut edits,
+                        );
+                    }
+                }
+            }
+            "plan.updated" => {
+                let mut lines = Vec::new();
+                let explanation = text(payload, "explanation");
+                if !explanation.trim().is_empty() {
+                    lines.extend([explanation.trim().to_owned(), String::new()]);
+                }
+                if let Some(steps) = payload["steps"].as_array() {
+                    for step in steps {
+                        let marker = match step["status"].as_str() {
+                            Some("completed") => "●",
+                            Some("inProgress") => "◐",
+                            _ => "○",
+                        };
+                        lines.push(format!("{marker} {}", text(step, "step")));
+                    }
+                }
+                if let Some(row) = self.plan {
+                    self.rows[row]["body"] = json!(lines.join("\n"));
+                    self.update(row, &mut edits);
+                } else {
+                    self.plan = Some(self.rows.len());
+                    self.append("Plan", lines.join("\n"), "plan", &mut edits);
+                }
+            }
+            "runtime.warning" => {
+                self.append("Activity", text(payload, "message"), "activity", &mut edits)
+            }
+            "runtime.error" => {
+                self.append("Error", text(payload, "message"), "error", &mut edits);
+                self.finish(timestamp, false, &mut edits);
+            }
+            "turn.completed" => {
+                let success = payload["status"] == "completed";
+                if !success {
+                    self.append(
+                        "Activity",
+                        if payload["status"] == "failed" {
+                            text(payload, "error")
+                        } else {
+                            "Interrupted".into()
+                        },
+                        "activity",
+                        &mut edits,
+                    );
+                }
+                self.finish(timestamp, success, &mut edits);
+            }
+            _ => {}
+        }
+        edits
+    }
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+
