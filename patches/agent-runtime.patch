+// SPDX-License-Identifier: LGPL-2.1-or-later
+
+mod composer;
+mod process;
+mod protocol;
+mod providers;
+mod store;
+mod supervisor;
+mod timeline;
+
+use process::IoEvent;
+use providers::ProviderAdapter;
+use serde_json::Value;
+use std::sync::mpsc;
+use store::Store;
+
+fn handle_host_message(
+    message: Value,
+    provider: &mut Option<Box<dyn ProviderAdapter>>,
+    sender: &mpsc::Sender<IoEvent>,
+) -> bool {
+    if message
+        .get("protocolVersion")
+        .and_then(Value::as_u64)
+        .is_some_and(|version| version != protocol::VERSION)
+    {
+        protocol::emit_error("Unsupported Anthracite runtime protocol version.");
+        return true;
+    }
+
+    let payload = protocol::payload(&message);
+    let result = match protocol::message_type(&message) {
+        "session.start" => {
+            let provider_config = payload.get("provider").unwrap_or(&Value::Null);
+            let kind = provider_config
+                .get("kind")
+                .and_then(Value::as_str)
+                .unwrap_or("");
+            let binary = provider_config
+                .get("binary")
+                .and_then(Value::as_str)
+                .unwrap_or("");
+            let cwd = payload.get("cwd").and_then(Value::as_str).unwrap_or(".");
+            let database_path = payload
+                .get("storagePath")
+                .and_then(Value::as_str)
+                .unwrap_or("");
+            if database_path.is_empty() {
+                protocol::emit_error("Anthracite storage path is empty.");
+                return true;
+            }
+            Store::open(
+                database_path,
+                payload.get("document").unwrap_or(&Value::Null),
+                kind,
+                payload.get("localThreadId").and_then(Value::as_str),
+                payload
+                    .get("createThread")
+                    .and_then(Value::as_bool)
+                    .unwrap_or(false),
+            )
+            .and_then(|store| providers::start(kind, binary, cwd, sender, store))
+            .map(|started| *provider = Some(started))
+        }
+        "turn.start" => provider
+            .as_mut()
+            .ok_or_else(|| "Provider is not running.".to_string())
+            .and_then(|provider| {
+                provider.start_turn(
+                    payload.get("prompt").and_then(Value::as_str).unwrap_or(""),
+                    payload.get("model").and_then(Value::as_str).unwrap_or(""),
+                    payload.get("effort").and_then(Value::as_str).unwrap_or(""),
+                    &payload["attachments"],
+                )
+            }),
+        "tool.prepare" => provider
+            .as_ref()
+            .ok_or_else(|| "Provider is not running.".to_string())
+            .and_then(|provider| provider.emitter().prepare_tool(payload)),
+        "tool.result" => provider
+            .as_mut()
+            .ok_or_else(|| "Provider is not running.".to_string())
+            .and_then(|provider| {
+                provider.emitter().finish_tool(
+                    &payload.get("requestId").cloned().unwrap_or(Value::Null),
+                    payload.get("result").and_then(Value::as_str).unwrap_or(""),
+                )?;
+                provider.emitter().emit("tool.observation", payload.clone());
+                provider.return_tool_result(
+                    payload.get("requestId").cloned().unwrap_or(Value::Null),
+                    payload.get("result").and_then(Value::as_str).unwrap_or(""),
+                    payload
+                        .get("success")
+                        .and_then(Value::as_bool)
+                        .unwrap_or(false),
+                    payload.get("images").unwrap_or(&Value::Null),
+                )
+            }),
+        "request.resolve" => provider
+            .as_mut()
+            .ok_or_else(|| "Provider is not running.".to_string())
+            .and_then(|provider| {
+                provider.resolve_request(
+                    payload
+                        .get("requestId")
+                        .and_then(Value::as_str)
+                        .unwrap_or(""),
+                    payload
+                        .get("decision")
+                        .and_then(Value::as_str)
+                        .unwrap_or(""),
+                )
+            }),
+        "user_input.resolve" => provider
+            .as_mut()
+            .ok_or_else(|| "Provider is not running.".to_string())
+            .and_then(|provider| {
+                provider.resolve_user_input(
+                    payload
+                        .get("requestId")
+                        .and_then(Value::as_str)
+                        .unwrap_or(""),
+                    payload.get("answers").unwrap_or(&Value::Null),
+                )
+            }),
+        "timeline.earlier" => provider
+            .as_ref()
+            .ok_or_else(|| "Provider is not running.".to_string())
+            .map(|provider| {
+                provider
+                    .emitter()
+                    .timeline_earlier(payload["before"].as_str().unwrap_or_default())
+            }),
+        "timeline.details" => provider
+            .as_ref()
+            .ok_or_else(|| "Provider is not running.".to_string())
+            .map(|provider| {
+                provider.emitter().timeline_details(
+                    payload["id"].as_str().unwrap_or_default(),
+                    payload["offset"].as_u64().unwrap_or_default() as usize,
+                )
+            }),
+        "draft.save" => provider
+            .as_mut()
+            .ok_or_else(|| "Provider is not running.".to_string())
+            .map(|provider| {
+                provider.save_draft(
+                    &composer::draft(payload),
+                    payload.get("saveId").unwrap_or(&Value::Null),
+                );
+            }),
+        "model.selection.save" => provider
+            .as_mut()
+            .ok_or_else(|| "Provider is not running.".to_string())
+            .map(|provider| {
+                provider.save_model_selection(
+                    payload.get("model").and_then(Value::as_str).unwrap_or(""),
+                    payload.get("effort").and_then(Value::as_str).unwrap_or(""),
+                );
+            }),
+        "turn.interrupt" => provider
+            .as_mut()
+            .ok_or_else(|| "Provider is not running.".to_string())
+            .and_then(|provider| provider.interrupt()),
+        "session.shutdown" => return false,
+        command => Err(format!("Unknown runtime command: {command}")),
+    };
+
+    if let Err(error) = result {
+        if let Some(provider) = provider {
+            provider
+                .emitter()
+                .emit("runtime.error", serde_json::json!({"message": error}));
+        } else {
+            protocol::emit_error(error);
+        }
+    }
+    true
+}
+
+fn main() {
+    if std::env::args_os().nth(1).as_deref() == Some(std::ffi::OsStr::new("--supervise")) {
+        let code = supervisor::run(std::env::args_os().skip(2).collect()).unwrap_or_else(|error| {
+            eprintln!("Anthracite launcher: {error}");
+            1
+        });
+        std::process::exit(code);
+    }
+    let arguments = std::env::args().collect::<Vec<_>>();
+    if arguments.get(1).map(String::as_str) == Some("--mcp-proxy") {
+        let result = match (arguments.get(2), arguments.get(3)) {
+            (Some(address), Some(token)) => process::run_mcp_proxy(address, token),
+            _ => Err("Usage: anthracite-runtime --mcp-proxy ADDRESS TOKEN".to_string()),
+        };
+        if let Err(error) = result {
+            eprintln!("{error}");
+            std::process::exit(1);
+        }
+        return;
+    }
+
+    let (sender, receiver) = mpsc::channel();
+    process::spawn_host_reader(sender.clone());
+
+    let mut provider: Option<Box<dyn ProviderAdapter>> = None;
+    while let Ok(event) = receiver.recv() {
+        match event {
+            IoEvent::HostLine(line) => match serde_json::from_str::<Value>(&line) {
+                Ok(message) => {
+                    if !handle_host_message(message, &mut provider, &sender) {
+                        break;
+                    }
+                }
+                Err(error) => protocol::emit_error(format!("Invalid host JSON: {error}")),
+            },
+            IoEvent::HostClosed => break,
+            IoEvent::ProviderLine(line) => match serde_json::from_str::<Value>(&line) {
+                Ok(message) => {
+                    if let Some(provider) = &mut provider
+                        && let Err(error) = provider.handle_message(message)
+                    {
+                        provider
+                            .emitter()
+                            .emit("runtime.error", serde_json::json!({"message": error}));
+                    }
+                }
+                Err(error) => protocol::emit_error(format!("Invalid provider JSON: {error}")),
+            },
+            IoEvent::ProviderLog(line) => {
+                if std::env::var_os("ANTHRACITE_PROVIDER_LOG").is_some() {
+                    eprintln!("provider: {line}");
+                }
+            }
+            IoEvent::ProviderError(line) => eprintln!("provider: {line}"),
+            IoEvent::ProviderClosed => {
+                if let Some(provider) = &provider {
+                    provider.emitter().emit(
+                        "runtime.error",
+                        serde_json::json!({"message": "Provider process closed its output."}),
+                    );
+                }
+                provider = None;
+            }
+            IoEvent::McpMessage { message, response } => {
+                if let Some(provider) = &mut provider
+                    && let Err(error) = provider.handle_mcp_message(message, response)
+                {
+                    provider
+                        .emitter()
+                        .emit("runtime.error", serde_json::json!({"message": error}));
+                }
+            }
+        }
+    }
+}
