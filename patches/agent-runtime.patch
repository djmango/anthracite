+// SPDX-License-Identifier: LGPL-2.1-or-later
+
+use serde_json::{Value, json};
+use std::cell::RefCell;
+use std::collections::HashMap;
+use std::io::{self, Write};
+
+use crate::store::Store;
+use crate::timeline::Timeline;
+
+fn timestamped(mut payload: Value) -> Value {
+    payload["timestampMs"] = json!(
+        std::time::SystemTime::now()
+            .duration_since(std::time::UNIX_EPOCH)
+            .unwrap_or_default()
+            .as_millis() as u64
+    );
+    payload
+}
+
+pub const VERSION: u64 = 2;
+
+pub fn message_type(message: &Value) -> &str {
+    message.get("type").and_then(Value::as_str).unwrap_or("")
+}
+
+pub fn payload(message: &Value) -> &Value {
+    message.get("payload").unwrap_or(&Value::Null)
+}
+
+pub fn emit_raw(message_type: &str, payload: Value) {
+    let stdout = io::stdout();
+    let mut output = stdout.lock();
+    let value = json!({
+        "protocolVersion": VERSION,
+        "type": message_type,
+        "payload": payload
+    });
+    if serde_json::to_writer(&mut output, &value).is_ok() {
+        let _ = output.write_all(b"\n");
+        let _ = output.flush();
+    }
+}
+
+pub fn emit_error(message: impl Into<String>) {
+    emit_raw(
+        "runtime.error",
+        json!({"class": "provider_error", "message": message.into()}),
+    );
+}
+
+pub fn emit_warning(message: impl Into<String>) {
+    emit_raw("runtime.warning", json!({"message": message.into()}));
+}
+
+pub struct Emitter {
+    store: Store,
+    operations: RefCell<HashMap<String, Value>>,
+    timeline: RefCell<Timeline>,
+}
+
+impl Emitter {
+    pub fn new(store: Store) -> Self {
+        let emitter = Self {
+            store,
+            operations: RefCell::new(HashMap::new()),
+            timeline: RefCell::new(Timeline::default()),
+        };
+        emit_raw("thread.local.ready", emitter.store.summary());
+        emitter.emit_thread_list();
+        match emitter.store.history() {
+            Ok(events) => {
+                let mut timeline = emitter.timeline.borrow_mut();
+                for event in events {
+                    timeline.apply(
+                        event["type"].as_str().unwrap_or_default(),
+                        &event["payload"],
+                    );
+                }
+                emit_raw("timeline.edit", Timeline::transport(timeline.snapshot()));
+            }
+            Err(error) => emit_warning(format!("Could not load conversation history: {error}")),
+        }
+        match emitter.store.draft() {
+            Ok(body) => emit_raw("draft.loaded", crate::composer::load_draft(&body)),
+            Err(error) => emit_warning(format!("Could not load composer draft: {error}")),
+        }
+        match emitter.store.model_selection() {
+            Ok(selection) => emit_raw("model.selection", selection),
+            Err(error) => emit_warning(format!("Could not load model selection: {error}")),
+        }
+        // History restoration replaces the timeline; warn only afterward.
+        match emitter.store.unresolved_count() {
+            Ok(count) if count != "0" => emit_warning(format!(
+                "{count} CAD operation(s) have unknown outcomes. Inspect the document and operations table; do not replay their Python."
+            )),
+            Err(error) => emit_warning(error),
+            _ => {}
+        }
+        emitter
+    }
+
+    pub fn call_tool(&self, mut payload: Value) -> Result<(), String> {
+        let key = payload["requestId"].to_string();
+        if self.operations.borrow().contains_key(&key) {
+            return Err("Duplicate FreeCAD tool request; not executing again".into());
+        }
+        let id = self
+            .store
+            .begin_operation(&payload)
+            .map_err(|e| format!("FreeCAD was not executed: could not persist operation: {e}"))?;
+        payload["operationId"] = json!(id);
+        self.operations.borrow_mut().insert(key, payload.clone());
+        self.emit("tool.activity", payload.clone());
+        emit_raw("tool.call", payload);
+        Ok(())
+    }
+
+    pub fn prepare_tool(&self, payload: &Value) -> Result<(), String> {
+        let key = payload["requestId"].to_string();
+        let operations = self.operations.borrow();
+        let call = operations.get(&key).ok_or("Unknown FreeCAD operation")?;
+        if call["operationId"] != payload["operationId"] {
+            return Err("Operation ID mismatch".into());
+        }
+        self.store
+            .prepare_operation(call["operationId"].as_str().unwrap(), &payload["context"])
+            .map_err(|e| {
+                format!("FreeCAD was not executed: could not persist running state: {e}")
+            })?;
+        let mut execution = call.clone();
+        execution["context"] = payload["context"].clone();
+        emit_raw("tool.execute", execution);
+        Ok(())
+    }
+
+    pub fn finish_tool(&self, request_id: &Value, result: &str) -> Result<(), String> {
+        let key = request_id.to_string();
+        let operations = self.operations.borrow();
+        let call = operations
+            .get(&key)
+            .ok_or("Unknown FreeCAD operation result")?;
+        let id = call["operationId"].as_str().unwrap();
+        self.store.finish_operation(id, result).map_err(|e| {
+            // If storage is unavailable even this may fail. Exclusive startup
+            // recovery will classify the remaining running row as unknown.
+            let _ = self.store.mark_operation_unknown(id);
+            format!("CAD outcome could not be durably recorded. Inspect the document; do not rerun the Python. Operation {id}: {e}")
+        })
+    }
+
+    fn project_timeline(&self, message_type: &str, payload: &Value) {
+        for edit in self.timeline.borrow_mut().apply(message_type, payload) {
+            emit_raw("timeline.edit", Timeline::transport(edit));
+        }
+    }
+
+    pub fn timeline_earlier(&self, before: &str) {
+        emit_raw(
+            "timeline.edit",
+            Timeline::transport(self.timeline.borrow().earlier(before)),
+        );
+    }
+
+    pub fn timeline_details(&self, id: &str, offset: usize) {
+        emit_raw("timeline.edit", self.timeline.borrow().details(id, offset));
+    }
+
+    pub fn emit(&self, message_type: &str, payload: Value) {
+        let payload = timestamped(payload);
+        if let Err(error) = self.store.record(message_type, &payload) {
+            emit_warning(format!("Could not persist runtime event: {error}"));
+        }
+        self.project_timeline(message_type, &payload);
+        emit_raw(message_type, payload);
+    }
+
+    pub fn record(&self, message_type: &str, payload: &Value) {
+        let payload = timestamped(payload.clone());
+        if let Err(error) = self.store.record(message_type, &payload) {
+            emit_warning(format!("Could not persist runtime event: {error}"));
+        }
+        self.project_timeline(message_type, &payload);
+        if message_type == "content.user" {
+            self.emit_thread_list();
+        }
+    }
+
+    pub fn provider_thread_id(&self) -> Result<Option<String>, String> {
+        self.store.provider_thread_id()
+    }
+
+    pub fn set_provider_thread_id(&self, provider_thread_id: &str) {
+        if let Err(error) = self.store.set_provider_thread_id(provider_thread_id) {
+            emit_warning(format!("Could not persist provider thread id: {error}"));
+        }
+    }
+
+    pub fn save_draft(&self, body: &str, save_id: &Value) {
+        match self.store.save_draft(body) {
+            Ok(()) => emit_raw("draft.saved", json!({"saveId": save_id})),
+            Err(error) => emit_warning(format!("Could not persist composer draft: {error}")),
+        }
+    }
+
+    pub fn save_model_selection(&self, model: &str, effort: &str) {
+        match self.store.save_model_selection(model, effort) {
+            Ok(()) => emit_raw("model.selection", json!({"model": model, "effort": effort})),
+            Err(error) => emit_warning(format!("Could not persist model selection: {error}")),
+        }
+    }
+
+    fn emit_thread_list(&self) {
+        match self.store.threads() {
+            Ok(threads) => emit_raw(
+                "thread.list",
+                json!({
+                    "currentThreadId": self.store.local_thread_id(),
+                    "threads": threads
+                }),
+            ),
+            Err(error) => emit_warning(format!("Could not list conversations: {error}")),
+        }
+    }
+}
+
+#[cfg(test)]
