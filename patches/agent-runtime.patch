+// SPDX-License-Identifier: LGPL-2.1-or-later
+#![cfg(unix)]
+
+use std::fs::{self, File};
+use std::io::{Read, Write};
+use std::os::fd::FromRawFd;
+use std::os::unix::process::CommandExt;
+use std::process::{Child, Command, ExitStatus, Stdio};
+use std::time::{Duration, Instant};
+
+const RUNTIME: &str = env!("CARGO_BIN_EXE_anthracite-runtime");
+const FIXTURE: &str = env!("CARGO_BIN_EXE_anthracite-test-fixture");
+
+struct Running {
+    child: Child,
+    application: Option<i32>,
+}
+
+impl Drop for Running {
+    fn drop(&mut self) {
+        if self.child.try_wait().ok().flatten().is_none() {
+            if let Some(pid) = self.application {
+                unsafe {
+                    libc::kill(-pid, libc::SIGKILL);
+                }
+            }
+            let _ = self.child.kill();
+            let deadline = Instant::now() + Duration::from_secs(2);
+            while Instant::now() < deadline {
+                if self.child.try_wait().ok().flatten().is_some() {
+                    break;
+                }
+                std::thread::sleep(Duration::from_millis(20));
+            }
+        }
+    }
+}
+
+fn drain(terminal: &mut File, output: &mut Vec<u8>) {
+    let mut buffer = [0; 8192];
+    loop {
+        match terminal.read(&mut buffer) {
+            Ok(0) => break,
+            Ok(size) => output.extend_from_slice(&buffer[..size]),
+            Err(error)
+                if error.kind() == std::io::ErrorKind::WouldBlock
+                    || error.raw_os_error() == Some(libc::EIO) =>
+            {
+                break;
+            }
+            Err(error) if error.kind() == std::io::ErrorKind::Interrupted => continue,
+            Err(error) => panic!("terminal read: {error}"),
+        }
+    }
+}
+
+fn wait(running: &mut Running, mut terminal: Option<&mut File>) -> ExitStatus {
+    let deadline = Instant::now() + Duration::from_secs(10);
+    let mut output = Vec::new();
+    loop {
+        if let Some(ref mut terminal) = terminal {
+            drain(terminal, &mut output);
+        }
+        if let Some(status) = running.child.try_wait().unwrap() {
+            return status;
+        }
+        assert!(
+            Instant::now() < deadline,
+            "supervisor did not exit: {}",
+            String::from_utf8_lossy(&output)
+        );
+        std::thread::sleep(Duration::from_millis(20));
+    }
+}
+
+fn signal_case(terminal_interrupt: bool, stubborn: bool) {
+    let directory = tempfile::tempdir().unwrap();
+    let application = directory.path().join("application with spaces");
+    fs::copy(FIXTURE, &application).unwrap();
+    let log = directory.path().join("signals.log");
+    let mut master = -1;
+    let mut slave = -1;
+    assert_eq!(
+        unsafe {
+            libc::openpty(
+                &mut master,
+                &mut slave,
+                std::ptr::null_mut(),
+                std::ptr::null_mut(),
+                std::ptr::null_mut(),
+            )
+        },
+        0
+    );
+    let mut terminal = unsafe { File::from_raw_fd(master) };
+    let slave = unsafe { File::from_raw_fd(slave) };
+    assert_ne!(
+        unsafe { libc::fcntl(master, libc::F_SETFL, libc::O_NONBLOCK) },
+        -1
+    );
+    let mut command = Command::new(
+        std::env::var_os("ANTHRACITE_TEST_NU")
+            .expect("Run through just test (ANTHRACITE_TEST_NU required)"),
+    );
+    command
+        .arg("--no-config-file")
+        .arg(
+            std::env::var_os("ANTHRACITE_TEST_LAUNCHER")
+                .expect("ANTHRACITE_TEST_LAUNCHER required"),
+        )
+        .arg(&application)
+        .arg("--supervisor")
+        .arg(RUNTIME)
+        .env("ANTHRACITE_SIGNAL_LOG", &log)
+        .env_remove("ANTHRACITE_EXIT_CODE")
+        .env_remove("ANTHRACITE_STUBBORN")
+        .stdin(Stdio::from(slave.try_clone().unwrap()))
+        .stdout(Stdio::from(slave.try_clone().unwrap()))
+        .stderr(Stdio::from(slave.try_clone().unwrap()));
+    for kind in ["CONFIG", "DATA", "STATE", "CACHE"] {
+        command.env(format!("XDG_{kind}_HOME"), directory.path().join(kind));
+    }
+    if stubborn {
+        command.env("ANTHRACITE_STUBBORN", "1");
+    }
+    unsafe {
+        command.pre_exec(|| {
+            if libc::setsid() == -1 || libc::ioctl(0, libc::TIOCSCTTY as _, 0) == -1 {
+                return Err(std::io::Error::last_os_error());
+            }
+            Ok(())
+        });
+    }
+    let mut running = Running {
+        child: command.spawn().unwrap(),
+        application: None,
+    };
+    drop(slave);
+    let deadline = Instant::now() + Duration::from_secs(15);
+    let mut output = Vec::new();
+    let pid = loop {
+        drain(&mut terminal, &mut output);
+        let contents = fs::read_to_string(&log).unwrap_or_default();
+        if let Some(line) = contents.lines().find(|line| line.starts_with("READY ")) {
+            if let Ok(pid) = line[6..].parse::<i32>() {
+                break pid;
+            }
+        }
+        assert!(
+            Instant::now() < deadline,
+            "application did not start: {}",
+            String::from_utf8_lossy(&output)
+        );
+        std::thread::sleep(Duration::from_millis(20));
+    };
+    running.application = Some(pid);
+    assert_ne!(unsafe { libc::getpgid(pid) }, unsafe {
+        libc::getpgid(running.child.id() as i32)
+    });
+    if terminal_interrupt {
+        terminal.write_all(&[3]).unwrap(); // Real terminal Ctrl-C.
+    } else {
+        assert_eq!(
+            unsafe { libc::kill(running.child.id() as i32, libc::SIGTERM) },
+            0
+        );
+    }
+    assert_eq!(wait(&mut running, Some(&mut terminal)).code(), Some(0));
+    let contents = fs::read_to_string(log).unwrap();
+    assert!(!contents.lines().any(|line| line == "INT"), "{contents}");
+    assert!(contents.lines().any(|line| line == "TERM"), "{contents}");
+    assert_eq!(
+        unsafe { libc::kill(pid, 0) },
+        -1,
+        "application was not reaped"
+    );
+    assert_eq!(
+        std::io::Error::last_os_error().raw_os_error(),
+        Some(libc::ESRCH)
+    );
+}
+
+#[test]
+fn ctrl_c_is_forwarded_as_sigterm() {
+    signal_case(true, false);
+}
+
+#[test]
+fn sigterm_is_forwarded() {
+    signal_case(false, false);
+}
+
+#[test]
+fn stubborn_child_is_killed() {
+    signal_case(true, true);
+}
+
+#[test]
+fn preserves_exit_code() {
+    let child = Command::new(RUNTIME)
+        .args(["--supervise", FIXTURE])
+        .env("ANTHRACITE_EXIT_CODE", "7")
+        .spawn()
+        .unwrap();
+    assert_eq!(
+        wait(
+            &mut Running {
+                child,
+                application: None
+            },
+            None
+        )
+        .code(),
+        Some(7)
+    );
+}
+
+#[test]
+fn missing_executable_fails() {
+    let directory = tempfile::tempdir().unwrap();
+    let child = Command::new(RUNTIME)
+        .arg("--supervise")
+        .arg(directory.path().join("missing"))
+        .stdout(Stdio::null())
+        .stderr(Stdio::null())
+        .spawn()
+        .unwrap();
+    assert!(
+        !wait(
+            &mut Running {
+                child,
+                application: None
+            },
+            None
+        )
+        .success()
+    );
+}
